  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>APP OVERVIEW</b>\r\n\r\nUniTopia is an offline, 2D campus navigation
    game for Cavite State University\u2013Main Campus. It helps users explore the
    campus, locate buildings, and learn about available services, departments, and
    courses.\r\n\r\nFeatures include walking and scooter navigation, route guidance,
    a minimap, pinch-to-zoom controls, and interactive building information.\r\n\r\nUniTopia
    serves as a virtual campus orientation guide.\r\n\r\n\r\n<b>DEVELOPMENT CREDITS</b>\r\n\r\n<b>Jasper
    John Dreo</b>\r\nDeveloper / Programmer\r\nTesting and Quality Assurance\r\n\r\n<b>Hezekiah
    Novales</b>\r\nCo-Developer\r\nCampus Map Design\r\nGame Asset Creation\r\n\r\n<b>Cristine
    Mae De Vela</b>\r\nUI Design\r\nAudio and Sound Effects\r\nProject Coordination"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
