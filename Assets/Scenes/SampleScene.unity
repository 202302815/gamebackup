  m_Script: {fileID: 11500000, guid: f3088de8fa367e44aa6d200eaed91545, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HowToPlayManager
  tutorialPanel: {fileID: 432754993}
  titleText: {fileID: 1443813885}
  descriptionText: {fileID: 1950843868}
  pageNumberText: {fileID: 2131797095}
  tutorialImage: {fileID: 215909198}
  backButton: {fileID: 999198853}
  nextButtonText: {fileID: 1360253612}
  pages:
  - title: Movement and Zoom
    description: Use the direction buttons to move. Spread two fingers to zoom in;
      bring them together to zoom out. Zoom has a minimum and maximum limit.
    image: {fileID: 21300000, guid: f810797ce44ee36419ebc695b016e8e5, type: 3}
  - title: Find a Building
    description: Tap Search and type a building name. Choose Walking or Vehicle,
      then select your destination. Walking routes lead to pedestrian entrances;
      vehicle routes lead to road-accessible arrival points.
    image: {fileID: 21300000, guid: d53eada0f245e3b4287b60d0cfd03b13, type: 3}
  - title: Follow Your Route
    description: Follow the arrow above your character and the yellow trail on the
      minimap. Guidance disappears when you arrive. Tap Cancel Route to stop navigation.
    image: {fileID: 21300000, guid: 4284bcc12f8e6334d84f491c0a804c77, type: 3}
  - title: Vehicle Rules
    description: Walk on sidewalks, pedestrian paths, and crossings. Use the scooter
      on vehicle roads and permitted parking areas. After switching modes, follow
      the message to reach the correct area. Wrong-way travel triggers a warning
      and stops further movement after a short allowance.
    image: {fileID: 21300000, guid: bda2ebcb15c5db345873334f4a78d730, type: 3}
  - title: Building Information
    description: Approach a sign and tap Building Info. Select an available Information,
      Departments, or Courses Offered tab. Swipe to read longer content. Tap X to
      close.
    image: {fileID: 21300000, guid: 2229d418c6f71b94ca1d886389a476a4, type: 3}
  onTutorialFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1404374313}
        m_TargetAssemblyTypeName: StartGameMenu, Assembly-CSharp
        m_MethodName: BeginExploring
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onTutorialReplayFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 147098842}
        m_TargetAssemblyTypeName: OptionsMenuController, Assembly-CSharp
        m_MethodName: ReturnFromTutorial
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
